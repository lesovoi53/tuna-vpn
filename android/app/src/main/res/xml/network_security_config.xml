<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- App-owned HTTP clients require TLS. Native VPN forwarding is separate.
         Trust stays limited to system roots; no localhost or user-CA exemption. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
